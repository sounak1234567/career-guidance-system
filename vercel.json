{
    "version": 2, 
    "buildCommand": "npm run build",
    "outputDirectory": "packages/frontend/dist",
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "packages/backend/src/server.ts"
        }, 
        {
            "source": "/(.*)", 
            "destination": "/index.html"
        }
    ]
}
